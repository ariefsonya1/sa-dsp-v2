<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginHorizontal="3dp"
    android:background="@drawable/bg_fader_card"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="6dp">

    <View
        android:id="@+id/ledTop"
        android:layout_width="16dp"
        android:layout_height="3dp"
        android:background="#00E5FF"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GRAPHIC EQ"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30 BAND SEND"
        android:textColor="#8091A5"
        android:textSize="8sp"
        android:maxLines="1"
        android:layout_marginBottom="4dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VU"
            android:textColor="#78909C"
            android:textSize="9sp" />
        <View
            android:id="@+id/ledClip"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#263238" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="2dp">

        <ProgressBar
            android:id="@+id/vuMeterBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="90dp"
            android:layout_height="4dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="-32dp"
            android:rotation="270"
            android:max="100"
            android:progress="0"
            android:progressTint="#00E676"
            android:progressBackgroundTint="#0D1115" />

        <SeekBar
            android:id="@+id/faderSeekBar"
            android:layout_width="115dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:rotation="270"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/bg_fader_track"
            android:thumb="@drawable/bg_fader_thumb"
            android:splitTrack="false" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvValue"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="#090C0E"
        android:gravity="center"
        android:text="+0.0 dB"
        android:textColor="#ECEFF1"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
