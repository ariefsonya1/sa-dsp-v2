<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0E11"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#14191F"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIGITAL SOUND CONSOLE"
                android:textColor="#00E5FF"
                android:textSize="7sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TaGunner Style EQ"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDspStatus"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:background="#090C0F"
            android:gravity="center"
            android:text="DSP STATUS: Post 30-Band • MBC aktif • EQ aktif"
            android:textColor="#FF7043"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/btnDspPower"
            android:layout_width="86dp"
            android:layout_height="28dp"
            android:textOn="● DSP ON"
            android:textOff="○ DSP OFF"
            android:checked="true"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_btn" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button android:id="@+id/tabMix" android:layout_width="76dp" android:layout_height="30dp" android:text="MIX" android:textSize="10sp" android:textColor="#FF5252" android:background="@drawable/bg_pill_btn" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/tabEq30" android:layout_width="76dp" android:layout_height="30dp" android:text="EQ30" android:textSize="10sp" android:textColor="#B0BEC5" android:background="@drawable/bg_pill_btn" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/tabParam" android:layout_width="82dp" android:layout_height="30dp" android:text="PARAM" android:textSize="10sp" android:textColor="#B0BEC5" android:background="@drawable/bg_pill_btn" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/tabFx" android:layout_width="68dp" android:layout_height="30dp" android:text="FX" android:textSize="10sp" android:textColor="#B0BEC5" android:background="@drawable/bg_pill_btn" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/tabDyn" android:layout_width="72dp" android:layout_height="30dp" android:text="DYN" android:textSize="10sp" android:textColor="#B0BEC5" android:background="@drawable/bg_pill_btn" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/tabSpace" android:layout_width="78dp" android:layout_height="30dp" android:text="SPACE" android:textSize="10sp" android:textColor="#B0BEC5" android:background="@drawable/bg_pill_btn" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/tabSaved" android:layout_width="78dp" android:layout_height="30dp" android:text="SAVED" android:textSize="10sp" android:textColor="#B0BEC5" android:background="@drawable/bg_pill_btn" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/tabSignal" android:layout_width="78dp" android:layout_height="30dp" android:text="SIGNAL" android:textSize="10sp" android:textColor="#B0BEC5" android:background="@drawable/bg_pill_btn" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/tabCon" android:layout_width="72dp" android:layout_height="30dp" android:text="CON" android:textSize="10sp" android:textColor="#B0BEC5" android:background="@drawable/bg_pill_btn"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/barMixControls"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MIX BUS • VU frekuensi LOW / MID / HIGH / BASS • MASTER keluaran langsung"
            android:textColor="#90A4AE"
            android:textSize="9sp" />

        <ToggleButton
            android:id="@+id/btnHead"
            android:layout_width="68dp"
            android:layout_height="24dp"
            android:textOn="● HEAD"
            android:textOff="○ HEAD"
            android:checked="false"
            android:textColor="#FF5252"
            android:textSize="9sp"
            android:background="@drawable/bg_pill_btn"
            android:layout_marginEnd="4dp"/>

        <ToggleButton
            android:id="@+id/btnLimit"
            android:layout_width="68dp"
            android:layout_height="24dp"
            android:textOn="● LIMIT"
            android:textOff="○ LIMIT"
            android:checked="true"
            android:textColor="#00E676"
            android:textSize="9sp"
            android:background="@drawable/bg_pill_btn"
            android:layout_marginEnd="4dp"/>

        <ToggleButton
            android:id="@+id/btnVu"
            android:layout_width="60dp"
            android:layout_height="24dp"
            android:textOn="● VU"
            android:textOff="○ VU"
            android:checked="true"
            android:textColor="#00E676"
            android:textSize="9sp"
            android:background="@drawable/bg_pill_btn" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerFadersMix"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <include android:id="@+id/chGraphicEq" layout="@layout/item_fader_channel" />
        <include android:id="@+id/chParametric" layout="@layout/item_fader_channel" />
        <include android:id="@+id/chLow" layout="@layout/item_fader_channel" />
        <include android:id="@+id/chMid" layout="@layout/item_fader_channel" />
        <include android:id="@+id/chHigh" layout="@layout/item_fader_channel" />
        <include android:id="@+id/chBassBoost" layout="@layout/item_fader_channel" />
        <include android:id="@+id/chMaster" layout="@layout/item_fader_channel" />

    </LinearLayout>

</LinearLayout>
